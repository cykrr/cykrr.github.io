---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { languages, defaultLang } from "../i18n/ui";

const { pathname } = Astro.url;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// Path with the locale prefix removed, so /en and /en/ are recognised as home.
const basePath = pathname.replace(`/${lang}`, "").replace(/index\.html$/, "");
const isHome = basePath === "/" || basePath === "";

// Prefix a path for the active locale; the default locale lives at the root.
const localised = (path: string) =>
  lang === defaultLang ? path : `/${lang}${path === "/" ? "" : path}`;
---

<header>
  <div class="masthead">
    <a class="brand" href={localised("/")}>{t('site.title')}</a>
    <nav class="menu">
      <a href={localised("/zen")}>{t('nav.zen')}</a>
      <a href="https://status.krr.cl/status/krr-cl">{t('nav.status')}</a>
      <a href="#projects">{t('nav.projects')}</a>
      <a href={localised("/blog")}>{t('nav.blog')}</a>
    </nav>
  </div>

  <div class="subhead">
    {isHome ? <p class="tagline">{t('nav.motiv')}</p> : <span></span>}
    <div class="langs">
      {Object.entries(languages).map(([locale, name], i) => (
        <>
          {i > 0 && <span>·</span>}
          <a
            href={locale === defaultLang ? (basePath || "/") : `/${locale}${basePath === "/" ? "" : basePath}`}
            aria-current={locale === lang ? "true" : undefined}
          >{name}</a>
        </>
      ))}
    </div>
  </div>
</header>
