---
import Layout from '../../layouts/Layout.astro';

const posts = Object.values(import.meta.glob('./*.md', { eager: true })) as any[];

// Sort posts by date (latest first)
posts.sort((a, b) => {
  const dateA = new Date(a.frontmatter.date || '2000-01-01');
  const dateB = new Date(b.frontmatter.date || '2000-01-01');
  return dateB.valueOf() - dateA.valueOf();
});
---

<Layout title="Blog">
  <section>
    <h2 class="h-section">Blog</h2>
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <a href={post.url}>{post.frontmatter.title}</a>
          {post.frontmatter.date && (
            <span class="date">{new Date(post.frontmatter.date).toLocaleDateString()}</span>
          )}
        </li>
      ))}
    </ul>
  </section>
</Layout>
