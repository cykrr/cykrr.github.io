---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="Página no encontrada">
  <section class="hero">
    <p class="eyebrow">404</p>
    <h1>Esta página no existe.</h1>
    <p class="hero-copy">Puede que el enlace haya cambiado o que la página se haya movido. Si llegaste desde un enlace viejo, <a href="mailto:me@krr.cl">escríbeme</a>.</p>
    <div class="hero-actions">
      <a class="button button-primary" href="/">Volver al inicio</a>
      <a class="button" href="mailto:me@krr.cl">Contacto</a>
    </div>
  </section>
</Layout>
