---
import CaseStudy from "@/layouts/CaseStudy.astro";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";
import preview from "@/assets/previews/floreria-coral.png";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const site = "https://floreriacoral.cl";
const tags = ["ecommerce", "local_business", "wordpress", "woocommerce", "webpay", "operation"];
const built = [1, 2, 3, 4, 5] as const;
---

<CaseStudy
  title={t('floreria.title')}
  role={t('floreria.role')}
  team={t('floreria.team_status')}
  tags={tags.map((k) => t(`floreria.tags.${k}`))}
  image={preview}
  imageAlt={t('floreria.aside.img_alt')}
  links={[{ href: site, label: t('floreria.aside.button') }]}
  people={{ title: t('floreria.aside.developed_by'), names: ["Benjamin Robles"] }}
  backHref={lang === 'en' ? '/en/' : '/'}
  backLabel={lang === 'en' ? '← Back home' : '← Volver al inicio'}
>
  <p set:html={t('floreria.lede')}></p>

  <section>
    <h2>{t('floreria.problem.title')}</h2>
    <p set:html={t('floreria.problem.p1')}></p>
    <p set:html={t('floreria.problem.p2')}></p>
  </section>

  <section>
    <h2>{t('floreria.built.title')}</h2>
    <p set:html={t('floreria.built.intro')}></p>
    {built.map((n) => (
      <>
        <h3>{t(`floreria.built.${n}.title`)}</h3>
        <p set:html={t(`floreria.built.${n}.description`)}></p>
      </>
    ))}
  </section>

  <section>
    <h2>{t('floreria.change.title')}</h2>
    <p set:html={t('floreria.change.p1')}></p>
    <p set:html={t('floreria.change.p2')}></p>
  </section>

  <!--
    TODO (contenido real): cuando exista un dato verificado del cliente, agregar
    aquí una métrica real (por ejemplo, pedidos por mes, conversión o tiempo
    ahorrado) y una cita de una línea de la dueña sobre el cambio. No publicar
    cifras sin verificar.
  -->

  <section>
    <h2>{t('floreria.stack.title')}</h2>
    <p set:html={t('floreria.stack.p1')}></p>
    <p set:html={t('floreria.stack.p2')}></p>
  </section>
</CaseStudy>
