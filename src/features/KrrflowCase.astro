---
import CaseStudy from "@/layouts/CaseStudy.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import shot from "@/assets/previews/krrflow.png";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const eng = ['cache', 'decode', 'pool', 'audio', 'look', 'profile'] as const;
---

<CaseStudy
  title={t('krrflow.title')}
  role={t('krrflow.eyebrow')}
  team={t('krrflow.status')}
  image={shot}
  imageAlt={t('krrflow.alt')}
  backHref={lang === 'en' ? '/en/' : '/'}
  backLabel={t('krrflow.back')}
>
  <p>{t('krrflow.lede')}</p>

  <section>
    <h2>{t('krrflow.idea.title')}</h2>
    <p set:html={t('krrflow.idea.p1')}></p>
    <p set:html={t('krrflow.idea.p2')}></p>
  </section>

  <section>
    <h2>{t('krrflow.eng.title')}</h2>
    {eng.map((k) => (
      <>
        <h3>{t(`krrflow.eng.${k}.title`)}</h3>
        <p set:html={t(`krrflow.eng.${k}.text`)}></p>
      </>
    ))}
  </section>

  <section>
    <h2>{t('krrflow.shape.title')}</h2>
    <p set:html={t('krrflow.shape.text')}></p>
  </section>
</CaseStudy>
