---
import CaseStudy from "@/layouts/CaseStudy.astro";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import shot from "@/assets/previews/krrflow.png";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const features = ['gpu', 'gapless', 'pace', 'tracks', 'pad', 'seek'] as const;
const eng = ['cache', 'decode', 'pool', 'audio', 'pace', 'look', 'profile'] as const;
---

<CaseStudy
  title={t('krrflow.title')}
  role={t('krrflow.eyebrow')}
  team={t('krrflow.status')}
  image={shot}
  imageAlt={t('krrflow.alt')}
  backHref={lang === 'en' ? '/en/' : '/'}
  backLabel={t('krrflow.back')}
>
  <p>{t('krrflow.lede')}</p>

  <section>
    <h2>{t('krrflow.idea.title')}</h2>
    <p set:html={t('krrflow.idea.p1')}></p>
    <p set:html={t('krrflow.idea.p2')}></p>
  </section>

  <section>
    <h2>{t('krrflow.features.title')}</h2>
    <ul class="projects">
      {features.map((k) => (
        <li>
          <span class="name">{t(`krrflow.features.${k}.title`)}</span>
          <span class="blurb">{t(`krrflow.features.${k}.text`)}</span>
        </li>
      ))}
    </ul>
  </section>

  <section>
    <h2>{t('krrflow.eng.title')}</h2>
    {eng.map((k) => (
      <>
        <h3>{t(`krrflow.eng.${k}.title`)}</h3>
        <p set:html={t(`krrflow.eng.${k}.text`)}></p>
      </>
    ))}
  </section>

  <section>
    <h2>{t('krrflow.shape.title')}</h2>
    <p set:html={t('krrflow.shape.text')}></p>
  </section>
</CaseStudy>
