---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import Portfolio from './Portfolio.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section>
  <h2 class="h-section">{t('welcome.whoami.title')}</h2>
  <p>{t('welcome.whoami.description')}</p>
  <p>{t('welcome.contact')} <a href="mailto:me@krr.cl">me@krr.cl</a></p>
</section>

<Portfolio />
