---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import Portfolio from './Portfolio.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- Lum Invader greeting - using predominant sky cyan #ACF6FB + gold #FBEAAA -->
<section class="mb-8 rounded-xl p-4 relative overflow-hidden border" style="border-color: rgba(172, 246, 251, 0.25); background: linear-gradient(135deg, rgba(172, 246, 251, 0.06), rgba(229, 103, 152, 0.03));">
  <span class="absolute top-2 left-2 text-[var(--lum-sky)] opacity-20 text-lg">⚡</span>
  <span class="absolute bottom-2 right-2 text-[var(--lum-pink-bright)] opacity-20 text-lg">⚡</span>
  
  <div class="flex items-center gap-3 mb-2">
    <span class="text-2xl">👽</span>
    <div>
      <p class="text-sm font-bold uppercase tracking-wide" style="color: var(--lum-pink);">
        ✨ Lum says...
      </p>
      <p class="text-zinc-300 text-base" style="font-family: 'VT323', monospace;">
        "Darling! Welcome to my page! 💕"
      </p>
    </div>
  </div>
</section>

<section class="mb-8">
  <h2 class="text-zinc-100 text-xl font-bold pb-1 mb-4" style="border-bottom: 2px solid rgba(172, 246, 251, 0.2);">
    {t('welcome.whoami.title')}
  </h2>
  <p class="mb-4 text-zinc-300 leading-relaxed">
    {t('welcome.whoami.description')}
  </p>
  <p class="text-zinc-300">
    {t('welcome.contact')} <a href="mailto:me@krr.cl" class="transition-colors">me@krr.cl</a>
  </p>
</section>

<Portfolio />

