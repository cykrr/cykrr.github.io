---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { BOOKING_URL } from "../consts";
import Portfolio from './Portfolio.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const inspectorPath = lang === 'en' ? '/en/portfolio/inspector-ia' : '/portfolio/inspector-ia';

const proofs = ['one', 'two', 'three', 'four'] as const;
const flow = ['capture', 'analysis', 'review', 'procore'] as const;
const services = ['terrain', 'docs', 'commerce'] as const;
const steps = ['step1', 'step2', 'step3', 'step4'] as const;
---

<section class="hero" aria-labelledby="intro-title">
  <p class="eyebrow">{t('welcome.hero.eyebrow')}</p>
  <h1 id="intro-title">{t('welcome.hero.title')}</h1>
  <p class="hero-copy">{t('welcome.hero.description')}</p>
  <div class="hero-actions">
    <a class="button button-primary" href={BOOKING_URL}>{t('welcome.hero.primary')}</a>
    <a class="button" href={inspectorPath}>{t('welcome.hero.secondary')}</a>
  </div>
  <p class="hero-note">{t('welcome.hero.note')}</p>
  <ul class="proof">
    {proofs.map((k) => <li>{t(`welcome.proof.${k}`)}</li>)}
  </ul>
</section>

<section class="featured-work" aria-labelledby="featured-title">
  <p class="eyebrow">{t('welcome.featured.eyebrow')}</p>
  <h2 id="featured-title">{t('welcome.featured.title')}</h2>
  <p>{t('welcome.featured.description')}</p>
  <a class="featured-link" href={inspectorPath}>{t('welcome.featured.link')}</a>
  <ol class="flow">
    {flow.map((k, i) => (
      <li>
        <span class="flow-num">{String(i + 1).padStart(2, '0')}</span>
        <span class="name">{t(`welcome.flow.${k}.title`)}</span>
        <span class="blurb">{t(`welcome.flow.${k}.text`)}</span>
      </li>
    ))}
  </ol>
</section>

<section>
  <h2 class="h-section">{t('welcome.services.title')}</h2>
  <dl class="services">
    {services.map((k) => (
      <div>
        <dt>{t(`welcome.services.${k}.title`)}</dt>
        <dd>{t(`welcome.services.${k}.description`)}</dd>
      </div>
    ))}
  </dl>
</section>

<Portfolio />

<section>
  <h2 class="h-section">{t('welcome.process.title')}</h2>
  <ol class="process">
    {steps.map((k) => (
      <li>
        <span class="name">{t(`welcome.process.${k}.title`)}</span>
        <span class="blurb">{t(`welcome.process.${k}.description`)}</span>
      </li>
    ))}
  </ol>
</section>

<section>
  <h2 class="h-section">{t('welcome.whoami.title')}</h2>
  <p>{t('welcome.whoami.p1')}</p>
  <p>{t('welcome.whoami.p2')}</p>
  <p>{t('welcome.contact')} <a href="mailto:me@krr.cl">me@krr.cl</a> · <a href="https://github.com/cykrr">github.com/cykrr</a></p>
</section>

<section>
  <h2 class="h-section">{t('welcome.outside.title')}</h2>
  <p>{t('welcome.outside.text')}</p>
</section>

<section class="cta" aria-labelledby="cta-title">
  <h2 id="cta-title">{t('welcome.cta.title')}</h2>
  <p>{t('welcome.cta.text')}</p>
  <a class="button button-primary" href={BOOKING_URL}>{t('welcome.cta.button')}</a>
  <p class="cta-note">{t('welcome.cta.note')}</p>
</section>
