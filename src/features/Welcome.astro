---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import Portfolio from './Portfolio.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const floreriaPath = lang === 'en' ? '/en/portfolio/floreria-coral' : '/portfolio/floreria-coral';

const doing = ['speech', 'product', 'systems', 'ai'] as const;
---

<section class="hero" aria-labelledby="intro-title">
  <p class="eyebrow">{t('welcome.hero.eyebrow')}</p>
  <h1 id="intro-title">{t('welcome.hero.title')}</h1>
  <p class="hero-copy">{t('welcome.hero.description')}</p>
  <div class="hero-actions">
    <a class="button button-primary" href="#floreria-coral">{t('welcome.hero.primary')}</a>
    <a class="button" href="mailto:me@krr.cl">{t('welcome.hero.secondary')}</a>
  </div>
</section>

<section id="floreria-coral" class="featured-work" aria-labelledby="floreria-coral-title">
  <p class="eyebrow">{t('welcome.featured.eyebrow')}</p>
  <h2 id="floreria-coral-title">{t('welcome.featured.title')}</h2>
  <p>{t('welcome.featured.description')}</p>
  <a class="featured-link" href={floreriaPath}>{t('welcome.featured.link')}</a>
</section>

<section>
  <h2 class="h-section">{t('welcome.whoami.title')}</h2>
  <p>{t('welcome.whoami.p1')}</p>
  <p>{t('welcome.whoami.p2')}</p>
  <p>{t('welcome.contact')} <a href="mailto:me@krr.cl">me@krr.cl</a> · <a href="https://github.com/cykrr">github.com/cykrr</a></p>
</section>

<section>
  <h2 class="h-section">{t('welcome.doing.title')}</h2>
  <ul class="projects">
    {doing.map((k) => (
      <li>
        <span class="name">{t(`welcome.doing.${k}.title`)}</span>
        <span class="blurb">{t(`welcome.doing.${k}.description`)}</span>
      </li>
    ))}
  </ul>
</section>

<Portfolio />

<section>
  <h2 class="h-section">{t('welcome.outside.title')}</h2>
  <p>{t('welcome.outside.text')}</p>
</section>
