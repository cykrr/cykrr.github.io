---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { defaultLang } from "../i18n/ui";

interface Props {
  /** Render the section heading as an H1 when this is a standalone page. */
  page?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { page = false } = Astro.props;
const Heading = page ? 'h1' : 'h2';

// Prefix internal paths for the active locale; the default locale lives at the root.
const localised = (path: string) => (lang === defaultLang ? path : `/${lang}${path}`);

// `href` links the title; `src` adds a trailing source link. Projects with
// neither are private or client work and render as plain text.
const groups = [
  {
    heading: 'portfolio.group.client',
    items: [
      { key: 'inspector_ia', href: '/portfolio/inspector-ia' },
      { key: 'plan_integral', href: '/portfolio/plan-integral' },
      { key: 'floreria_coral', href: '/portfolio/floreria-coral', live: 'https://floreriacoral.cl' },
    ],
  },
  {
    heading: 'portfolio.group.lab',
    items: [
      { key: 'krrflow', href: '/portfolio/krrflow' },
      { key: 'ha_lite', href: '/portfolio/ha-lite', src: 'https://github.com/cykrr/ha-lite' },
      { key: 'ioscpy', src: 'https://github.com/cykrr/ioscpy' },
      { key: 'mdserve', href: 'https://notes.krr.cl/mdserve/', src: 'https://github.com/cykrr/mdserve' },
      { key: 'kindle_dashboard', src: 'https://github.com/cykrr/kindle-dashboard' },
      { key: 'cc_systems', href: '/graph/' },
    ],
  },
  {
    heading: 'portfolio.group.research',
    items: [
      { key: 'chilean_asr' },
    ],
  },
  {
    heading: 'portfolio.group.previous',
    items: [
      { key: 'planetariumvr', href: '/portfolio/planetarium-vr', src: 'https://github.com/cykrr/planetariumvr' },
      { key: 'biolab_escape', href: '/portfolio/biolab-escape' },
    ],
  },
] as const;
---

<section>
  <Heading id="projects" class="h-section">{t('portfolio.software.title')}</Heading>
  <p set:html={t('portfolio.software.description')}></p>

  {groups.map((g) => (
    <>
      <h3 class="h-group">{t(g.heading)}</h3>
      <ul class="projects">
        {g.items.map((p) => (
          <li>
            {'href' in p && p.href
              ? <a class="name" href={p.href.startsWith('/portfolio') ? localised(p.href) : p.href}>{t(`portfolio.software.${p.key}.title`)}</a>
              : <span class="name">{t(`portfolio.software.${p.key}.title`)}</span>}
            {'src' in p && p.src && <a class="src" href={p.src}>(GitHub)</a>}
            {'live' in p && p.live && <a class="src" href={p.live}>({t('portfolio.live')})</a>}
            <span class="blurb" set:html={t(`portfolio.software.${p.key}.description`)}></span>
          </li>
        ))}
      </ul>
    </>
  ))}
</section>
