---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const services = [
  { name: "Voz-CL", href: "https://voz-cl.krr.cl", label: "voz-cl.krr.cl", notes: t('portfolio.table.vozcl.notes') },
  { name: "Biolab Escape", href: "https://krr.cl/biolab-escape", label: "krr.cl/biolab-escape", notes: t('portfolio.table.biolab.notes') },
];

const projects = [
  { key: 'chilean_asr' }, { key: 'cc_systems' }, { key: 'freelance_saas' },
  { key: 'planetariumvr', href: '/portfolio/planetarium-vr', src: 'https://github.com/cykrr/planetariumvr' },
  { key: 'floreria_coral', href: '/portfolio/floreria-coral' },
  { key: 'biolab_escape', href: '/portfolio/biolab-escape' },
] as const;
---

<section>
  <h2 class="h-section">{t('portfolio.infra.title')}</h2>
  <p set:html={t('portfolio.infra.description')}></p>

  <dl class="svc">
    {services.map((s) => (
      <div>
        <dt>{s.name} — <a href={s.href}>{s.label}</a></dt>
        <dd set:html={s.notes}></dd>
      </div>
    ))}
  </dl>
</section>

<section>
  <h2 id="projects" class="h-section">{t('portfolio.software.title')}</h2>
  <p set:html={t('portfolio.software.description')}></p>

  <ul class="projects">
    {projects.map((p) => (
      <li>
        {p.href
          ? <a class="name" href={p.href}>{t(`portfolio.software.${p.key}.title`)}</a>
          : <span class="name">{t(`portfolio.software.${p.key}.title`)}</span>}
        {p.src && <a class="src" href={p.src}> {t('portfolio.software.planetariumvr.github')}</a>}
        <span class="blurb" set:html={t(`portfolio.software.${p.key}.description`)}></span>
      </li>
    ))}
  </ul>

  <p class="note">
    <b>{t('portfolio.warning.title')}</b>
    <span set:html={t('portfolio.warning.description')}></span>
    <a href="https://status.krr.cl/">{t('portfolio.warning.status')}</a>.
  </p>
</section>
