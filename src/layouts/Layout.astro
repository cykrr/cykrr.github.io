---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import NavBar from "@/components/NavBar.astro";
import "@/styles/global.css";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title } = Astro.props;
const pageTitle = title ? `${title} — ${t('site.title')}` : t('site.title');
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="dark" />
		<title>{pageTitle}</title>
	</head>
	<body>
		<NavBar />

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<div class="badges">
				<a href="https://astro.build"><img src="/img/badges/astro.webp" alt="Built with Astro" title="Astro" /></a>
				<a href="https://archlinux.org"><img src="/img/badges/archlinux.png" alt="archlinux btw" title="ArchLinux btw" /></a>
				<a href="https://ubuntu.org"><img src="https://cyber.dabamos.de/88x31/ubuntu-88x31.gif" alt="Ubuntu" /></a>
				<a href="https://neovim.org"><img src="https://seirdy.one/p/b/neovim.1579028659.png" alt="NeoVIM ftw" title="nvim ftw" /></a>
				<a href="https://anilist.co/anime/339/serial-experiments-lain"><img src="https://seirdy.one/p/b/lain.2347988494.png" alt="I never finished Lain.." title="I never finished Lain..." /></a>
				<a href="https://noscript.net/"><img src="https://www.88x31.nl/gifs/js.jpg" alt="Astro uses javascript.. Sorry about that." title="Astro uses javascript.." /></a>
				<a href="https://yesterweb.org/no-to-web3/"><img src="https://seirdy.one/p/b/keep.4031781130.webp" alt="Keep the web small" title="Keep the web small" /></a>
			</div>
			<p class="colophon">{t('portfolio.footer.text')}</p>
		</footer>
	</body>
</html>
