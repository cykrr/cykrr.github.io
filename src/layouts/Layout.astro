---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { defaultLang } from "../i18n/ui";
import NavBar from "@/components/NavBar.astro";
import "@/styles/global.css";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const localised = (path: string) => (lang === defaultLang ? path : `/${lang}${path}`);

const { title, description } = Astro.props;
const pageTitle = title ? `${title} — ${t('site.title')}` : t('site.title');
const pageDesc = description ?? t('site.description');
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/img/og.png', Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Benjamin Robles',
  url: 'https://krr.cl',
  email: 'me@krr.cl',
  jobTitle: 'Software engineer',
};
const professionalService = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Benjamin Robles',
  url: 'https://krr.cl',
  email: 'me@krr.cl',
  areaServed: ['Viña del Mar', 'Valparaíso', 'Chile'],
  knowsAbout: [
    'software a la medida',
    'inspección de obra',
    'automatización documental',
    'Webpay',
    'Procore',
    'IA aplicada',
  ],
};
const jsonLd = JSON.stringify([person, professionalService]).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="dark" />
		<title>{pageTitle}</title>
		<meta name="description" content={pageDesc} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="application/rss+xml" title={t('site.title')} href="/rss.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={t('site.title')} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={pageDesc} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:locale" content={lang === 'es' ? 'es_CL' : 'en_US'} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={pageDesc} />
		<meta name="twitter:image" content={ogImage} />

		<script type="application/ld+json" set:html={jsonLd} />
	</head>
	<body>
		<NavBar />

		<main>
			<slot />
		</main>

		<footer class="site-footer">
			<nav class="footer-links" aria-label="Contact">
				<a href="mailto:me@krr.cl">{t('nav.email')}</a>
				<a href="https://github.com/cykrr">{t('nav.github')}</a>
				<a href="https://status.krr.cl/">{t('nav.status')}</a>
				<a href={localised("/zen")}>{t('nav.zen')}</a>
			</nav>
			<div class="badges">
				<a href="https://astro.build"><img src="/img/badges/astro.webp" alt="Built with Astro" title="Astro" /></a>
				<a href="https://archlinux.org"><img src="/img/badges/archlinux.png" alt="archlinux btw" title="ArchLinux btw" /></a>
				<a href="https://ubuntu.org"><img src="https://cyber.dabamos.de/88x31/ubuntu-88x31.gif" alt="Ubuntu" /></a>
				<a href="https://neovim.org"><img src="https://seirdy.one/p/b/neovim.1579028659.png" alt="NeoVIM ftw" title="nvim ftw" /></a>
				<a href="https://anilist.co/anime/339/serial-experiments-lain"><img src="https://seirdy.one/p/b/lain.2347988494.png" alt="I never finished Lain.." title="I never finished Lain..." /></a>
				<a href="https://noscript.net/"><img src="https://www.88x31.nl/gifs/js.jpg" alt="Astro uses javascript.. Sorry about that." title="Astro uses javascript.." /></a>
				<a href="https://yesterweb.org/no-to-web3/"><img src="https://seirdy.one/p/b/keep.4031781130.webp" alt="Keep the web small" title="Keep the web small" /></a>
			</div>
			<p class="colophon">{t('portfolio.footer.text')}</p>
		</footer>
	</body>
</html>
