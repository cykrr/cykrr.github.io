---
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { defaultLang, languages } from "../i18n/ui";
import NavBar from "@/components/NavBar.astro";
import "@/styles/global.css";
import background from "../assets/background.svg";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<title>{t('site.title')}</title>
	</head>
	<body class="bg-[#0a0a12] text-[#F0F2F2] font-mono max-w-3xl mx-auto p-4 sm:p-8 selection:bg-pink-500/30 selection:text-pink-200 antialiased relative">
		<!-- Sky-cyan predominant color band at top (from #ACF6FB) -->
		<div class="fixed top-0 left-0 right-0 h-48 -z-20" style="background: linear-gradient(180deg, rgba(172,246,251,0.12) 0%, rgba(172,246,251,0.04) 60%, transparent 100%);"></div>

		<!-- Starry background -->
		<div class="fixed inset-0 w-full h-full -z-10 overflow-hidden">
			<img src={background.src} alt="" class="w-full h-full object-cover" />
		</div>

		<!-- Sky-cyan → pink gradient bar -->
		<div class="fixed top-0 left-0 w-full h-1 z-50" style="background: linear-gradient(90deg, transparent, #ACF6FB, #E56798, #DF5177, transparent); opacity: 0.7;"></div>

		<NavBar />

		<slot />

		<!-- Footer -->
		<div class="badges mt-16 pt-8 border-t relative flex flex-wrap gap-2" style="border-color: rgba(170, 160, 219, 0.2);">
			<div class="absolute -top-[1px] left-0 right-0 h-[2px]" style="background: repeating-linear-gradient(90deg, #ACF6FB 0px, #ACF6FB 8px, transparent 8px, transparent 16px, #E56798 16px, #E56798 24px, transparent 24px, transparent 32px); opacity: 0.35;"></div>
			
			<a href="https://astro.build">
				<img src="/img/badges/astro.webp" alt="Built with Astro" title="Astro">
			</a>
			<a href="https://archlinux.org">
				<img src="/img/badges/archlinux.png" alt="archlinux btw" title="ArchLinux btw">
			</a>
			<a href="https://ubuntu.org">
				<img src="https://cyber.dabamos.de/88x31/ubuntu-88x31.gif" alt="">
			</a>
			<a href="https://neovim.org">
				<img src="https://seirdy.one/p/b/neovim.1579028659.png" alt="NeoVIM ftw" title="nvim ftw">
			</a>
			<a href="https://anilist.co/anime/339/serial-experiments-lain">
				<img src="https://seirdy.one/p/b/lain.2347988494.png" alt="I never finished Lain.." title="I never finished Lain...">
			</a>
			<a href="https://noscript.net/">
				<img src="https://www.88x31.nl/gifs/js.jpg" alt="Astro uses javascript.. Sorry about that." title="Astro uses javascript..">
			</a>
			<a href="https://yesterweb.org/no-to-web3/">
				<img src="https://seirdy.one/p/b/keep.4031781130.webp" alt="Keep the web small" title="Keep the web small">
			</a>

			<!-- Lum signature -->
			<span class="ml-auto text-xs self-center" style="color: rgba(170, 160, 219, 0.4);">
				⚡ 💕
			</span>
		</div>
	</body>
</html>
